{
	"name": "reveal.js-tagteam",
	"version": "1.1.0",
	"description": "A plugin for Reveal.js that is used to dynamically show only certain sections in presentations when you don't want to show everything. It uses URL parameters to set the needed sections.",
	"keywords": [
		"reveal",
		"reveal.js",
		"reveal-plugin",
		"plugin",
		"hide",
		"hidden",
		"portfolio"
	],
	"homepage": "https://github.com/martinomagnifico/reveal.js-tagteam",
	"license": "MIT",
	"author": {
		"name": "Martijn De Jongh (Martino)",
		"email": "martijn.de.jongh@gmail.com",
		"web": "https://martinomagnifico.github.io",
		"url": "https://martinomagnifico.github.io",
		"username": "martinomagnifico"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/martinomagnifico/reveal.js-tagteam.git"
	},
	"type": "module",
	"main": "./plugin/tagteam/tagteam.js",
	"module": "./plugin/tagteam/tagteam.mjs",
	"exports": {
		".": {
			"import": "./plugin/tagteam/tagteam.mjs",
			"require": "./plugin/tagteam/tagteam.js"
		},
		"./plugin/tagteam/tagteam.esm.js": "./plugin/tagteam/tagteam.mjs"
	},
	"files": [
		"plugin/tagteam",
		"CHANGELOG.md"
	],
	"scripts": {
		"start": "npm run dev",
		"copy-reveal": "node scripts/copy-reveal.mjs",
		"copy-plugin": "node scripts/copy-plugin.mjs",
		"copy-simplemenu": "node scripts/copy-simplemenu.mjs",
		"dev": "vite",
		"prebuild": "rimraf demo plugin",
		"build-plugin": "vite build -c vite.lib.config.ts",
		"build-demo": "vite build -c vite.config.ts",
		"build": "npm run build-plugin && npm run build-demo && npm run copy-reveal && npm run copy-plugin && npm run copy-simplemenu",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"preview": "npm run build && vite preview",
		"ci": "biome ci ."
	},
	"peerDependencies": {
		"reveal.js": ">=4.0.0",
		"reveal.js-simplemenu": ">=2.0.0"
	},
	"peerDependenciesMeta": {
		"reveal.js-simplemenu": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/node": "^26.2.0",
		"@types/reveal.js": "^5.2.2",
		"@vituum/vite-plugin-pug": "^2.0.1",
		"fs-extra": "^11.4.0",
		"reveal.js-plugintoolkit": "^1.2.1",
		"reveal.js-simplemenu": "^2.1.1",
		"rimraf": "^6.1.3",
		"sass": "^1.103.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vituum": "^2.0.2"
	}
}
